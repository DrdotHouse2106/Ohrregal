# Beispiel-Einstellungen für Hörbuchwunsch. Kopieren als hoerbuch-wunsch.env (Docker)
# bzw. /etc/hoerbuch-wunsch/zugang.env (systemd), Werte anpassen, Datei nie einchecken.
# Kommentare nur in eigenen Zeilen: systemd versteht keine Kommentare hinter Werten.
# Die Pfade unten passen zur docker-compose.yml. Bei systemd die echten Pfade eintragen.

# --- Dienst ---
WUNSCH_PORT=8097
# IP des Reverse-Proxys, dessen X-Real-IP geglaubt wird (für die Fehlversuchssperre)
WUNSCH_PROXYS=
# höchstens so viele Hörbücher gleichzeitig laden
WUNSCH_PARALLEL=2
# nicht gefunden -> nach so vielen Stunden neu suchen (nur in der Ruhezeit)
WUNSCH_NEUVERSUCH_STUNDEN=24
# nur systemd: wo Datenbank und Tokens liegen (im Container fest unter /data)
#WUNSCH_DATENBANK=/var/lib/hoerbuch-wunsch/wunsch.sqlite
#WUNSCH_TOKENS=/var/lib/hoerbuch-wunsch/tokens.json

# --- Prowlarr (Pflicht) ---
# Schlüssel: Prowlarr → Settings → General → API Key
PROWLARR_URL=http://prowlarr:9696
PROWLARR_KEY=<prowlarr-api-key>
# 3030 = Audio/Audiobook
PROWLARR_KATEGORIEN=3030
# leer = alle aktiven Usenet-Indexer mit Hörbuch-Kategorie, sonst IDs mit Komma
PROWLARR_INDEXER=

# --- SABnzbd (Pflicht) ---
# Schlüssel: SABnzbd → Config → General → Security → API Key
SAB_URL=http://sabnzbd:8080
SAB_KEY=<sabnzbd-api-key>
# eigene Kategorie anlegen (Config → Categories), Ordner z. B. "hoerbuch-wunsch", NICHT in der Bibliothek
SAB_KATEGORIE=hoerbuchwunsch
# Pfad, unter dem SABnzbd den fertigen Kategorie-Ordner meldet = Pfad im Dienst
SAB_PFADE=<complete-pfad-wie-sabnzbd-ihn-sieht>/hoerbuch-wunsch=/downloads

# --- Audiobookshelf (Pflicht) ---
# Hörbuch-Bibliothek, wie der Dienst sie sieht
BIBLIOTHEK=/hoerbuecher
# derselbe Ordner, wie Audiobookshelf ihn sieht (ABS → Bibliothek bearbeiten → Ordner)
ABS_BIBLIOTHEK_PFAD=/audiobooks
# wird nur lesend geöffnet
ABS_DATENBANK=/abs-config/absdatabase.sqlite
# für die Anmeldung der App (GET /api/me)
ABS_URL=http://audiobookshelf:80
# ID der Hörbuch-Bibliothek: in ABS die Bibliothek öffnen, sie steht in der Adresse
# (…/library/<ID>/…). Leer = jeder ABS-Benutzer darf wünschen.
ABS_BIBLIOTHEK_ID=

# --- Podcasts abonnieren (optional) ---
# API-Schlüssel eines ABS-Admins (ABS → Einstellungen → API-Schlüssel). Nur für Podcast-Abos,
# weil ABS das Anlegen von Podcasts nur Admins erlaubt.
ABS_ADMIN_KEY=
ABS_PODCAST_BIBLIOTHEK=Podcasts
# Wann ABS neue Folgen sucht (Cron), und Land für die Suche im Apple-Verzeichnis
PODCAST_ZEITPLAN=0 * * * *
PODCAST_LAND=de

# --- Push an Ohrregal (optional) ---
# developer.apple.com → Certificates, IDs & Profiles → Keys → neuer Schlüssel mit APNs.
# Key-ID steht beim Schlüssel, Team-ID unter Membership. Topic = Bundle-ID der App.
APNS_SCHLUESSEL=/run/secrets/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=

# --- Audible-Katalog (Reihen, Hörspiele, Entdecken, Stöbern) ---
AUDIBLE_API=https://api.audible.de

# --- Ruhezeiten (optional) ---
# Jellyfin: Dashboard → API-Schlüssel → neuer Schlüssel. Leer = nur die ABS-Wiedergabe zählt.
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_KEY=
NACHT_VON=3
NACHT_BIS=6
ZEITZONE=Europe/Berlin

# --- Musik wünschen über Lidarr (optional) ---
# Schlüssel: Lidarr → Settings → General → API Key
LIDARR_URL=http://lidarr:8686
LIDARR_KEY=
# Wurzelordner wie in Lidarr → Settings → Media Management → Root Folders
LIDARR_ORDNER=/music
# IDs der Profile (Lidarr → Settings → Profiles; die ID steht beim Bearbeiten in der Adresse)
LIDARR_QUALITAETSPROFIL=1
LIDARR_METADATENPROFIL=1
# Anmeldung für Musik-Nutzer (Subsonic-Ping)
NAVIDROME_URL=http://navidrome:4533

# --- YouTube-Musik zuordnen (optional) ---
# Ordner mit Musik aus YouTube-Downloads (z. B. Pinchflat), im Container /youtube-musik.
# Mit ffprobe (systemd) werden auch die Tags gelesen, im Container nur Ordner- und Dateinamen.
YOUTUBE_MUSIK=
# Last.fm-API-Schlüssel (last.fm/api/account/create), für Nightcore-Originale
LASTFM_KEY=

# --- ntfy (optional, zusätzlich zu Apple Push) ---
NTFY_URL=
NTFY_TOKEN=
