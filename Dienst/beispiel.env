# Beispiel-Einstellungen für hoerbuch_wunsch.py – Werte anpassen, Datei nicht einchecken.
WUNSCH_BIND=0.0.0.0
WUNSCH_PORT=8097
WUNSCH_PROXYS=                    # IPs des Reverse-Proxys, dessen X-Real-IP geglaubt wird (Fehlversuchssperre)
WUNSCH_DATENBANK=/var/lib/hoerbuch-wunsch/wunsch.sqlite
WUNSCH_TOKENS=/var/lib/hoerbuch-wunsch/tokens.json
WUNSCH_PARALLEL=2                 # höchstens so viele Wünsche gleichzeitig laden
WUNSCH_NEUVERSUCH_STUNDEN=24      # nicht gefunden -> nach so vielen Stunden neu suchen

PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_KEY=<prowlarr-api-key>
PROWLARR_KATEGORIEN=3030          # Audio/Audiobook
PROWLARR_INDEXER=                 # leer = alle aktiven Usenet-Indexer mit Hörbuch-Kategorie

SAB_URL=http://127.0.0.1:8080
SAB_KEY=<sabnzbd-api-key>
SAB_KATEGORIE=hoerbuchwunsch      # eigene Kategorie, deren Ordner NICHT in der Bibliothek liegt
SAB_PFADE=                        # falls SABnzbd andere Pfade sieht: /sab/pfad=/dienst/pfad;...

BIBLIOTHEK=/pfad/zur/hoerbuch-bibliothek
ABS_DATENBANK=/pfad/zu/audiobookshelf/config/absdatabase.sqlite   # wird nur lesend geöffnet
ABS_BIBLIOTHEK_PFAD=/audiobooks   # derselbe Bibliotheksordner, wie Audiobookshelf ihn sieht
ABS_URL=http://127.0.0.1:13378    # Anmeldung der App mit ihrem ABS-Token (GET /api/me)
ABS_BIBLIOTHEK_ID=                # nur Benutzer mit Zugriff auf diese Bibliothek dürfen wünschen

NTFY_URL=                         # z. B. https://ntfy.example/hoerbuecher, leer = kein Push
NTFY_TOKEN=
